<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="8dp" android:background="#000000"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <Button android:id="@+id/clear_log_btn" android:text="CLEAR LOGS"/>
    <Button android:id="@+id/download_log_btn" android:text="DOWNLOAD LOGS"/>
    <Button android:id="@+id/choose_file_btn" android:text="CHOOSE FILE"/>
    <Button android:id="@+id/choose_folder_btn" android:text="CHOOSE FOLDER"/>
    <TextView android:id="@+id/frida_log" android:background="#000000" android:textColor="#FFFFFF" android:textSize="18sp" android:scrollbars="vertical" android:padding="8dp" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>