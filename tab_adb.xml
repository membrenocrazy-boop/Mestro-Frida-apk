<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="8dp" android:background="#000000"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <EditText android:id="@+id/adb_input" android:hint="Command" android:textColor="#FFFFFF" android:background="#1A1A1A"/>
    <Button android:id="@+id/adb_run_btn" android:text="Run"/>
    <TextView android:id="@+id/adb_output" android:background="#000000" android:textColor="#00FF00" android:scrollbars="vertical" android:padding="8dp" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>